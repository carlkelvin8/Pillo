# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=[YOUR SUPABASE URL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR ANON KEY]
# Public URL of this app (used in email links). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only, Nominatim-compatible provider URL for branch address search.
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=[YOUR SERVICE ROLE KEY]
DATABASE_URL=[YOUR POSTGRES URL]
# MCP connects as the limited `pillo_mcp` role: run `alter role pillo_mcp login password '...'` once, then use that login here.
# Required in production; in development MCP falls back to DATABASE_URL.
DATABASE_URL_MCP=

# Phase 3
PAYMONGO_SECRET_KEY=[YOUR PAYMONGO SECRET KEY]
PAYMONGO_WEBHOOK_SECRET=[YOUR PAYMONGO WEBHOOK SECRET]

# Local development only: "mock" gives fake payment links (ignored in production)
PAYMENTS_MODE=
# Online payment links (GCash, QR Ph, Maya, cards). Off unless exactly "true": until then Pillo only records payments.
# Local mock checkout also needs this set to true.
ONLINE_PAYMENTS_ENABLED=

# Keep unset. Live patient chat and owner questions stay off until the clinic-data privacy decision
# is made. Only "true" enables them.
LIVE_AI_ENABLED=

# Local synthetic-data demo only. Never use clinic or patient information here.
GEMINI_API_KEY=
# Optional. Default: gemini-3.8-flash.
GEMINI_MODEL=
