# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=[YOUR SUPABASE URL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR ANON KEY]
# Public URL of this app (used in email links). Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=[YOUR SERVICE ROLE KEY]
DATABASE_URL=[YOUR POSTGRES URL]

# Phase 3
PAYMONGO_SECRET_KEY=[YOUR PAYMONGO SECRET KEY]
PAYMONGO_WEBHOOK_SECRET=[YOUR PAYMONGO WEBHOOK SECRET]

# Local development only: "mock" gives fake payment links (ignored in production)
PAYMENTS_MODE=

# Local synthetic-data demo only. Never use clinic or patient information here.
GEMINI_API_KEY=
# Optional. Default: gemini-3.8-flash.
GEMINI_MODEL=
